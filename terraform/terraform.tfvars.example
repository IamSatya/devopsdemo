# Sample Terraform Configuration Variables
# Rename this file to 'terraform.tfvars' and customize values

aws_region       = "us-east-1"
environment      = "production"
project_name     = "pulsecare-healthcare"
instance_type    = "t3.micro"
key_name         = "my-aws-ssh-key" # Replace with your AWS Key Pair name
allowed_ssh_cidr = ["0.0.0.0/0"]    # Restrict to your home/office IP (e.g. ["203.0.113.25/32"])
